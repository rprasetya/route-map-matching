{
  "name": "route-map-matching",
  "version": "0.1.0",
  "description": "Fast, dependency-free GPS map matching: snap noisy GPS traces onto a road network with a hidden Markov model, in the browser, Node.js and PHP.",
  "keywords": [
    "map-matching",
    "gps",
    "snap-to-road",
    "hmm",
    "viterbi",
    "vector-tiles",
    "mvt",
    "maplibre",
    "routing",
    "geospatial"
  ],
  "license": "MIT",
  "author": "Raya Prasetya",
  "homepage": "https://rprasetya.github.io/route-map-matching/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rprasetya/route-map-matching.git"
  },
  "bugs": {
    "url": "https://github.com/rprasetya/route-map-matching/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tiles": {
      "import": {
        "types": "./dist/tiles/index.d.ts",
        "default": "./dist/tiles/index.js"
      },
      "require": {
        "types": "./dist/tiles/index.d.cts",
        "default": "./dist/tiles/index.cjs"
      }
    },
    "./traffic-side": {
      "import": {
        "types": "./dist/traffic-side.d.ts",
        "default": "./dist/traffic-side.js"
      },
      "require": {
        "types": "./dist/traffic-side.d.cts",
        "default": "./dist/traffic-side.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node scripts/bench.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "traffic-side": "python scripts/build-traffic-side.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "maplibre-gl": "^4.7.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
